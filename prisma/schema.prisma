// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Enum to hold the days for availability
enum DayOfWeek {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

// ---------------------------------------------
// AUTH MODELS
// ---------------------------------------------

// A user model
model User {
  id                     String                   @id @default(uuid())
  email                  String                   @unique
  passwordHash           String                   @unique
  isVerified             Boolean                  @default(false)
  refreshTokens          RefreshToken[]
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  EmailVerificationToken EmailVerificationToken[]
  resetTokens            PasswordResetToken[]
  passwordHistory        PasswordHistory[]

  profile           Profile?
  Message           Message[]
  ThreadParticipant ThreadParticipant[]
}

// A refresh token model
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  User User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([tokenHash])
}

// An email verification token model
model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([tokenHash])
}

// Password reset token model
model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([tokenHash])
}

// Model to store user's past passwords
// Prevents users from using the same password or password recycling during password resets
model PasswordHistory {
  id        String   @id @default(uuid())
  userId    String
  oldHash   String   @unique
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([oldHash])
}

// ---------------------------------------------
// PROFILE MODELS
// ---------------------------------------------

// Model to store the basic information for a user profile
model Profile {
  id             String  @id @default(uuid())
  userId         String  @unique
  name           String
  bio            String?
  major          String
  yearOfStudy    Int
  isTutor        Boolean @default(false)
  isTutee        Boolean @default(false)
  profilePicture String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  tutorCourses ProfileTutorCourse[]
  tuteeCourses ProfileTuteeCourse[]
  availability AvailabilitySlot[]

  @@index([major])
  @@index([yearOfStudy])
  @@index([isTutor])
  @@index([isTutee])
}

// Model to store Course objects, which will be preseeded
model Course {
  id                 Int                  @id @default(autoincrement())
  code               String               @unique
  name               String
  ProfileTutorCourse ProfileTutorCourse[]
  ProfileTuteeCourse ProfileTuteeCourse[]

  @@index([code])
}

// Model to hold courses someone wants to tutor in
model ProfileTutorCourse {
  id        String @id @default(uuid())
  profileId String
  courseId  Int

  profile Profile @relation(fields: [profileId], references: [userId], onDelete: Cascade)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@unique([profileId, courseId])
  @@index([courseId])
}

// Model to hold courses someone wants to be tutored in
model ProfileTuteeCourse {
  id        String @id @default(uuid())
  profileId String
  courseId  Int

  profile Profile @relation(fields: [profileId], references: [userId], onDelete: Cascade)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@unique([profileId, courseId])
  @@index([courseId])
}

// Model to hold a users various availability slots
model AvailabilitySlot {
  id        Int       @id @default(autoincrement())
  profileId String
  day       DayOfWeek
  startMin  Int
  endMin    Int

  createdAt DateTime @default(now())
  profile   Profile  @relation(fields: [profileId], references: [userId], onDelete: Cascade)

  @@index([profileId])
  @@index([day])
}

// ---------------------------------------------
// Messaging Models
// ---------------------------------------------

// Model to store messages and members of the thread
model Thread {
  id                 String    @id @default(uuid())
  lastMessageId      String?
  lastMessageAt      DateTime?
  lastMessagePreview String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages          Message[]
  ThreadParticipant ThreadParticipant[]

  @@index([updatedAt])
}

// Model to store the users that belong to a thread
model ThreadParticipant {
  id                 String  @id @default(uuid())
  threadId           String
  profileId          String
  lastReadMessageId  String?
  lastMessagePreview String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [profileId], references: [id])
  thread Thread @relation(fields: [threadId], references: [id])

  @@unique([threadId, profileId])
}

// Model to store messages
model Message {
  id        String   @id @default(uuid())
  threadId  String
  senderId  String
  content   String
  iv        String
  authTag   String
  createdAt DateTime @default(now())

  sender User   @relation(fields: [senderId], references: [id])
  thread Thread @relation(fields: [threadId], references: [id])

  @@index([threadId])
  @@index([createdAt])
}
