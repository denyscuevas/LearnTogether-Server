// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Enum to hold the days for availability
enum DayOfWeek {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

// ---------------------------------------------
// AUTH MODELS
// ---------------------------------------------

// A user model
model User {
  id                     String                   @id @default(uuid())
  email                  String                   @unique
  passwordHash           String
  isVerified             Boolean                  @default(false)
  refreshTokens          RefreshToken[]
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  EmailVerificationToken EmailVerificationToken[]
  resetTokens            PasswordResetToken[]
  passwordHistory        PasswordHistory[]

  role             UserRole        @default(USER)
  status           AccountStatus   @default(ACTIVE)
  suspendedAt      DateTime?
  suspensionReason String?
  reportsFiled     Report[]        @relation("ReportsFiled")
  reportsReceived  Report[]        @relation("ReportsReceived")
  reportsResolved  Report[]        @relation("ReportsResolved")
  adminActions     AdminAuditLog[] @relation("AdminActor")
  auditTargets     AdminAuditLog[] @relation("AuditTarget")

  profile           Profile?
  Message           Message[]
  ThreadParticipant ThreadParticipant[]

  @@index([status])
}

enum UserRole {
  USER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
}

enum ReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

enum ReportReason {
  HARASSMENT
  SPAM
  INAPPROPRIATE_CONTENT
  FAKE_PROFILE
  OTHER
}

enum AdminActionType {
  USER_SUSPENDED
  USER_REINSTATED
  REPORT_RESOLVED
  REPORT_DISMISSED
}

// A report filed by a user against another user
model Report {
  id             String       @id @default(uuid())
  reporterId     String
  reportedUserId String
  reason         ReportReason
  details        String?
  status         ReportStatus @default(PENDING)
  resolvedById   String?
  resolvedAt     DateTime?
  resolutionNote String?
  createdAt      DateTime     @default(now())

  reporter     User  @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser User  @relation("ReportsReceived", fields: [reportedUserId], references: [id], onDelete: Cascade)
  resolvedBy   User? @relation("ReportsResolved", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([reportedUserId])
}

// Record of actions taken by admins; rows survive user deletion
model AdminAuditLog {
  id           String          @id @default(uuid())
  adminId      String?
  action       AdminActionType
  targetUserId String?
  reportId     String?
  note         String?
  createdAt    DateTime        @default(now())

  admin      User? @relation("AdminActor", fields: [adminId], references: [id], onDelete: SetNull)
  targetUser User? @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([adminId, createdAt])
  @@index([targetUserId])
}

// A refresh token model
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  User User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

// An email verification token model
model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([tokenHash])
}

// Password reset token model
model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([tokenHash])
}

// Model to store user's past passwords
// Prevents users from using the same password or password recycling during password resets
model PasswordHistory {
  id        String   @id @default(uuid())
  userId    String
  oldHash   String   @unique
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([oldHash])
}

// ---------------------------------------------
// PROFILE MODELS
// ---------------------------------------------

// Model to store the basic information for a user profile
model Profile {
  id             String  @id @default(uuid())
  userId         String  @unique
  name           String
  bio            String?
  major          String
  yearOfStudy    Int
  isTutor        Boolean @default(false)
  isTutee        Boolean @default(false)
  profilePicture String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  tutorCourses          ProfileTutorCourse[]
  tuteeCourses          ProfileTuteeCourse[]
  availability          AvailabilitySlot[]
  sentRequests          ConnectionRequest[]  @relation("SentRequests")
  receivedRequests      ConnectionRequest[]  @relation("ReceivedRequests")
  notificationsReceived Notification[]       @relation("RecipientProfile")
  notificationsSent     Notification[]       @relation("SenderProfile")

  reviewsGiven          Review[]            @relation("ReviewsGiven")
  reviewsReceived       Review[]            @relation("ReviewsReceived")


  @@index([major])
  @@index([yearOfStudy])
  @@index([isTutor])
  @@index([isTutee])
}

// Model to store Course objects, which will be preseeded
model Course {
  id                 Int                  @id @default(autoincrement())
  code               String               @unique
  name               String
  ProfileTutorCourse ProfileTutorCourse[]
  ProfileTuteeCourse ProfileTuteeCourse[]

  @@index([code])
}

// Model to hold courses someone wants to tutor in
model ProfileTutorCourse {
  id        String @id @default(uuid())
  profileId String
  courseId  Int

  profile Profile @relation(fields: [profileId], references: [userId], onDelete: Cascade)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@unique([profileId, courseId])
  @@index([courseId])
}

// Model to hold courses someone wants to be tutored in
model ProfileTuteeCourse {
  id        String @id @default(uuid())
  profileId String
  courseId  Int

  profile Profile @relation(fields: [profileId], references: [userId], onDelete: Cascade)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@unique([profileId, courseId])
  @@index([courseId])
}

// Model to hold a users various availability slots
model AvailabilitySlot {
  id        Int       @id @default(autoincrement())
  profileId String
  day       DayOfWeek
  startMin  Int
  endMin    Int

  createdAt DateTime @default(now())
  profile   Profile  @relation(fields: [profileId], references: [userId], onDelete: Cascade)

  @@index([profileId])
  @@index([day])
}

// ---------------------------------------------
// Messaging Models
// ---------------------------------------------

// Model to store messages and members of the thread
model Thread {
  id                 String    @id @default(uuid())
  lastMessageId      String?
  lastMessageAt      DateTime?
  lastMessagePreview String?
  isAccepted         Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages          Message[]
  ThreadParticipant ThreadParticipant[]
  ConnectionRequest ConnectionRequest?

  @@index([updatedAt])
}

// Model to store the users that belong to a thread
model ThreadParticipant {
  id                 String  @id @default(uuid())
  threadId           String
  profileId          String
  lastReadMessageId  String?
  lastMessagePreview String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([threadId, profileId])
}

// Model to store messages
model Message {
  id        String   @id @default(uuid())
  threadId  String
  senderId  String
  content   String
  iv        String
  authTag   String
  createdAt DateTime @default(now())

  sender User   @relation(fields: [senderId], references: [id], onDelete: Cascade)
  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@index([createdAt])
}

// ---------------------------------------------
// Request Models
// ---------------------------------------------

// Model to hold the connection requests
model ConnectionRequest {
  id         String        @id @default(uuid())
  senderId   String
  receiverId String
  message    String?
  status     RequestStatus @default(PENDING)

  threadId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sender   Profile @relation("SentRequests", fields: [senderId], references: [userId], onDelete: Cascade)
  receiver Profile @relation("ReceivedRequests", fields: [receiverId], references: [userId], onDelete: Cascade)
  thread   Thread? @relation(fields: [threadId], references: [id])

  @@unique([senderId, receiverId])
  @@index([receiverId, status])
}

// Enum which holds the possible statuses for a connection request
enum RequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

// ---------------------------------------------
// Notification Models
// ---------------------------------------------

// Model which represents a notification object
model Notification {
  id          String           @id @default(uuid())
  recipientId String
  senderId    String
  type        NotificationType
  content     String
  entityId    String?
  isRead      Boolean          @default(false)
  createdAt   DateTime         @default(now())

  recipient Profile @relation("RecipientProfile", fields: [recipientId], references: [userId], onDelete: Cascade)
  sender    Profile @relation("SenderProfile", fields: [senderId], references: [userId], onDelete: Cascade)

  @@index([recipientId])
}

// Enum that holds the type of notification possible
enum NotificationType {
  CONNECTION_REQUEST
  REQUEST_ACCEPTED
}

model Review{
  id                  String           @id @default(uuid())
  reviewer_id         String
  reviewee_id         String
  course_id           String
  rating              Int
  comments            String?
  createdAt           DateTime         @default(now())

  reviewer            Profile          @relation("ReviewsGiven", fields: [reviewer_id], references: [userId], onDelete: Cascade)
  reviewee            Profile          @relation("ReviewsReceived", fields: [reviewee_id], references: [userId], onDelete: Cascade)


  @@index([reviewer_id])
  @@index([reviewee_id])
}
