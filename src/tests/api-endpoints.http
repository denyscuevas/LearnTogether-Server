### POST Register a User Test Route
POST {{ BASE_URL }}/api/auth/register
Content-Type: application/json

{
  "email": "testuser1@uwindsor.ca",
  "password": "newPassword@123",
  "password_confirmation": "newPassword@123"
}

### POST Logging in a User Test Route
POST {{ BASE_URL }}/api/auth/login
Content-Type: application/json

{
  "email": "testuser1@uwindsor.ca",
  "password": "newPassword@123"
}

### POST Resending a verification email
POST {{ BASE_URL }}/api/auth/resend-verification
Content-Type: application/json

{
  "email": "newmail@uwindsor.ca"
}

### GET Verify a user token for email verification
POST {{ BASE_URL }}/api/auth/verify-email
Content-Type: application/json

{
  "id": "438ed80f-ab46-4bb4-9a1a-0663dec6967a",
  "otpCode": "893401"
}

### POST Send a password reset email
POST {{ BASE_URL }}/api/auth/request-password-reset
Content-Type: application/json

{
  "email": "user4@uwindsor.ca"
}

### POST Verify password reset OTP
POST {{ BASE_URL }}/api/auth/verify-reset-otp
Content-Type: application/json

{
  "email": "user4@uwindsor.ca",
  "otp": "427907"
}

