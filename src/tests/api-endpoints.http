### POST Register a User Test Route
POST {{ BASE_URL }}/api/auth/register
Content-Type: application/json

{
  "email": "testuser2@uwindsor.ca",
  "password": "newPassword@123",
  "password_confirmation": "newPassword@123"
}

### POST Logging in a User Test Route
POST {{ BASE_URL }}/api/auth/login
Content-Type: application/json

{
  "email": "testuser1@uwindsor.ca",
  "password": "newPassword@123"
}

### POST Resending a verification email
POST {{ BASE_URL }}/api/auth/resend-verification
Content-Type: application/json

{
  "email": "testuser1@uwindsor.ca"
}

### GET Verify a user token for email verification
GET {{ BASE_URL }}/api/auth/verify-email
Content-Type: application/json

{
  "id": "d4b17dde-19dd-4d0e-81e9-ed352834dfd1",
  "otpCode": "321295"
}

### POST Send a password reset email
POST {{ BASE_URL }}/api/auth/request-password-reset
Content-Type: application/json

{
  "email": "user4@uwindsor.ca"
}

### POST Verify password reset OTP
POST {{ BASE_URL }}/api/auth/verify-reset-otp
Content-Type: application/json

{
  "email": "user4@uwindsor.ca",
  "otp": "427907"
}

### POST Reset password
POST {{ BASE_URL }}/api/auth/reset-password
Content-Type: application/json

{
  "userId": "0cbff286-c6d7-47ae-93cf-e070138a9a65",
  "password": "neewPassword#1244444",
  "password_confirmation": "neewPassword#1244444"
}

### POST Create a profile
POST {{ BASE_URL }}/api/profiles
Authorization: Bearer TOKEN_HERE
Content-Type: application/json

{
  "name": "Linus Torvald",
  "bio": "Second year CS student interested in tutoring COMP classes.",
  "major": "Computer Science",
  "yearOfStudy": 4,

  "isTutor": true,
  "isTutee": true,

  "tutorCourseIds": [1, 3, 5],
  "tuteeCourseIds": [91, 124],

  "availability": [
    { "day": "TUE", "startMin": 540, "endMin": 660 },
    { "day": "THU", "startMin": 840, "endMin": 960 }
  ]
}

### Get a users information (ME)
GET {{ BASE_URL }}/api/profiles/me
Authorization: Bearer Bearer TOKEN_HERE

